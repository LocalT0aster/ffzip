#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///
"""Resize and reencode videos with compact, shareable defaults."""

from __future__ import annotations

import argparse
import glob
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Final


DEFAULT_VIDEO_BITRATE: Final[str] = "2000k"
DEFAULT_MIN_SIDE: Final[int] = 720
DEFAULT_VIDEO_ENCODER: Final[str] = "libx264"
DEFAULT_CODEC_NAME: Final[str] = "h264"
BITRATE_RE: Final[re.Pattern[str]] = re.compile(
    r"^(?P<value>(?:\d+(?:\.\d*)?|\.\d+))(?P<suffix>[kKmM]?)$"
)
FRAME_RATE_RE: Final[re.Pattern[str]] = re.compile(
    r"^(?P<numerator>(?:\d+(?:\.\d*)?|\.\d+))(?:/(?P<denominator>\d+))?$"
)

FFPROBE_CMD: Final[list[str]] = [
    "ffprobe",
    "-v",
    "error",
    "-select_streams",
    "v:0",
    "-show_entries",
    "stream=width,height",
    "-of",
    "csv=p=0",
]
FFPROBE_VIDEO_BITRATE_CMD: Final[list[str]] = [
    "ffprobe",
    "-v",
    "error",
    "-select_streams",
    "v:0",
    "-show_entries",
    "stream=bit_rate",
    "-of",
    "csv=p=0",
]


@dataclass(frozen=True)
class Bitrate:
    """Validated ffmpeg bitrate value."""

    value: str
    bits_per_second: int


@dataclass(frozen=True)
class VideoSettings:
    """x264 quality settings."""

    bitrate: Bitrate | None
    crf: int | None
    frame_rate: str | None = None


def _parse_bitrate(value: str) -> Bitrate:
    """Parse positive ffmpeg-style bitrate values.

    Parameters
    ----------
    value
        Bitrate string such as ``1500k`` or ``2M``.

    Returns
    -------
    Bitrate
        Original value plus parsed bits per second.

    Raises
    ------
    argparse.ArgumentTypeError
        If the bitrate is not positive or cannot be parsed.
    """

    match = BITRATE_RE.fullmatch(value)
    if match is None:
        raise argparse.ArgumentTypeError(
            "expected a positive ffmpeg-style bitrate, e.g. 1500k or 2M"
        )

    number = float(match.group("value"))
    suffix = match.group("suffix").lower()
    multiplier = {"": 1, "k": 1_000, "m": 1_000_000}[suffix]
    bits_per_second = round(number * multiplier)
    if bits_per_second < 1:
        raise argparse.ArgumentTypeError("bitrate must be greater than zero")

    return Bitrate(value=value, bits_per_second=bits_per_second)


def _parse_crf(value: str) -> int:
    """Parse x264 CRF values.

    Parameters
    ----------
    value
        CRF value in the libx264 range.

    Returns
    -------
    int
        Parsed CRF value.

    Raises
    ------
    argparse.ArgumentTypeError
        If the CRF value is outside the libx264 range.
    """

    try:
        crf = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("CRF must be an integer from 0 to 51") from exc

    if not 0 <= crf <= 51:
        raise argparse.ArgumentTypeError("CRF must be an integer from 0 to 51")

    return crf


def _parse_min_side(value: str) -> int:
    """Parse a positive target size for the video's shorter side."""

    try:
        min_side = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("minimum side must be a positive integer") from exc

    if min_side < 1:
        raise argparse.ArgumentTypeError("minimum side must be a positive integer")

    return min_side


def _parse_frame_rate(value: str) -> str:
    """Parse positive decimal or rational ffmpeg frame rates."""

    match = FRAME_RATE_RE.fullmatch(value)
    if match is None:
        raise argparse.ArgumentTypeError(
            "frame rate must be a positive number or fraction, e.g. 24, 29.97, or 30000/1001"
        )

    numerator = float(match.group("numerator"))
    denominator_text = match.group("denominator")
    denominator = int(denominator_text) if denominator_text else 1
    if numerator <= 0 or denominator < 1:
        raise argparse.ArgumentTypeError("frame rate must be greater than zero")

    return value


def _format_bitrate(bits_per_second: int) -> str:
    """Format a parsed bitrate for ffmpeg."""

    if bits_per_second % 1_000 == 0:
        return f"{bits_per_second // 1_000}k"
    return str(bits_per_second)


def _video_quality_args(settings: VideoSettings) -> list[str]:
    """Build ffmpeg video quality arguments."""

    if settings.crf is not None:
        return ["-crf", str(settings.crf)]

    bitrate = settings.bitrate or _parse_bitrate(DEFAULT_VIDEO_BITRATE)
    maxrate = round(bitrate.bits_per_second * 1.05)
    bufsize = bitrate.bits_per_second * 2
    return [
        "-b:v",
        bitrate.value,
        "-maxrate",
        _format_bitrate(maxrate),
        "-bufsize",
        _format_bitrate(bufsize),
    ]


def _run_capture(cmd: list[str]) -> subprocess.CompletedProcess[str]:
    """Run a command and capture stdout/stderr.

    Parameters
    ----------
    cmd
        Command and arguments.

    Returns
    -------
    subprocess.CompletedProcess[str]
        Completed process result with captured output.
    """

    return subprocess.run(cmd, check=False, text=True, capture_output=True)


def _probe_resolution(path: Path) -> tuple[int, int]:
    """Get width and height for the first video stream.

    Parameters
    ----------
    path
        Input video path.

    Returns
    -------
    tuple[int, int]
        Width and height in pixels.

    Raises
    ------
    RuntimeError
        If ffprobe fails or the resolution cannot be parsed.
    """

    result = _run_capture([*FFPROBE_CMD, str(path)])
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "ffprobe failed")

    text = result.stdout.strip()
    if not text:
        raise RuntimeError("ffprobe returned empty resolution")

    parts = [p for p in re.split(r"[,\sx]+", text) if p]
    if len(parts) < 2:
        raise RuntimeError(f"unexpected ffprobe output: {text!r}")

    try:
        width = int(parts[0])
        height = int(parts[1])
    except ValueError as exc:
        raise RuntimeError(f"invalid resolution values: {text!r}") from exc

    if width < 1 or height < 1:
        raise RuntimeError("could not read resolution")

    return width, height


def _probe_video_bitrate(path: Path) -> Bitrate:
    """Get the declared bitrate for the first video stream.

    Raises
    ------
    RuntimeError
        If ffprobe fails or the stream does not declare a positive bitrate.
    """

    result = _run_capture([*FFPROBE_VIDEO_BITRATE_CMD, str(path)])
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or "ffprobe failed")

    text = result.stdout.strip()
    try:
        bits_per_second = int(text)
    except ValueError as exc:
        raise RuntimeError(f"invalid video bitrate: {text!r}") from exc

    if bits_per_second < 1:
        raise RuntimeError("could not read video bitrate")

    return Bitrate(
        value=_format_bitrate(bits_per_second),
        bits_per_second=bits_per_second,
    )


def _scale_filter(width: int, height: int, min_side: int) -> str:
    """Compute the scale filter for the target size.

    Parameters
    ----------
    width
        Input width in pixels.
    height
        Input height in pixels.

    Returns
    -------
    str
        ffmpeg scale filter expression.
    """

    source_min_side = min(width, height)
    if source_min_side > min_side:
        if width < height:
            return f"scale={min_side}:-2:flags=lanczos,setsar=1"
        return f"scale=-2:{min_side}:flags=lanczos,setsar=1"

    return f"scale={width}:{height},setsar=1"


def _output_path(
    input_path: Path,
    output: str | None,
    min_side: int,
    settings: VideoSettings,
) -> Path:
    if output:
        return Path(output)

    suffix = f"_{DEFAULT_CODEC_NAME}_{min_side}p"
    if settings.frame_rate is not None:
        suffix += f"_{settings.frame_rate.replace('/', '-')}fps"
    if settings.crf is not None:
        suffix += f"_C{settings.crf}"
    elif settings.bitrate is not None:
        suffix += f"_{settings.bitrate.value}"
    return input_path.with_name(f"{input_path.stem}{suffix}.mp4")


def _expand_inputs(inputs: list[str]) -> tuple[list[Path], list[str]]:
    """Expand glob patterns while preserving input order."""

    paths: list[Path] = []
    errors: list[str] = []
    for input_value in inputs:
        if glob.has_magic(input_value):
            matches = sorted(glob.glob(input_value, recursive=True))
            if not matches:
                errors.append(f"No matches for pattern: {input_value}")
            paths.extend(Path(match) for match in matches)
        else:
            paths.append(Path(input_value))
    return paths, errors


def _run_ffmpeg(
    input_path: Path,
    output_path: Path,
    scale_filter: str,
    settings: VideoSettings,
) -> int:
    frame_rate_args = ["-r", settings.frame_rate] if settings.frame_rate else []
    cmd = [
        "ffmpeg",
        "-i",
        str(input_path),
        "-vf",
        scale_filter,
        *frame_rate_args,
        "-c:v",
        DEFAULT_VIDEO_ENCODER,
        "-profile:v",
        "baseline",
        "-level",
        "3.1",
        *_video_quality_args(settings),
        "-c:a",
        "aac",
        "-b:a",
        "128k",
        "-ar",
        "48000",
        "-movflags",
        "+faststart",
        str(output_path),
    ]
    return subprocess.run(cmd, check=False).returncode


def _build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Resize and reencode a video, capping its shorter side without upscaling."
        )
    )
    parser.add_argument(
        "inputs",
        nargs="+",
        help="Input video file paths or glob patterns",
    )
    parser.add_argument(
        "-o",
        "--output",
        help="Output file path; requires exactly one input file",
    )
    parser.add_argument(
        "-s",
        "--min-side",
        type=_parse_min_side,
        default=DEFAULT_MIN_SIDE,
        metavar="PIXELS",
        help=(
            "Maximum size of the shorter side; larger inputs are downscaled without "
            f"upscaling (default: {DEFAULT_MIN_SIDE})."
        ),
    )
    parser.add_argument(
        "-r",
        "--frame-rate",
        type=_parse_frame_rate,
        metavar="RATE",
        help="Output frame rate, e.g. 24, 29.97, or 30000/1001.",
    )
    quality_group = parser.add_mutually_exclusive_group()
    quality_group.add_argument(
        "-b",
        "--video-bitrate",
        type=_parse_bitrate,
        metavar="BITRATE",
        help=(
            "Target video bitrate for bitrate mode "
            f"(default: {DEFAULT_VIDEO_BITRATE}; examples: 1500k, 2M). "
            "Mutually exclusive with --crf."
        ),
    )
    quality_group.add_argument(
        "--crf",
        type=_parse_crf,
        metavar="CRF",
        help=(
            "Use x264 CRF quality mode instead of bitrate mode. "
            "Range: 0-51; lower means higher quality and larger files; "
            "common values: 18-28. Mutually exclusive with --video-bitrate."
        ),
    )
    quality_group.add_argument(
        "-k",
        "--keep-bitrate",
        action="store_true",
        help=(
            "Use the input video stream's declared bitrate. Mutually exclusive with "
            "--video-bitrate and --crf."
        ),
    )
    return parser


def main(argv: list[str]) -> int:
    parser = _build_parser()
    args = parser.parse_args(argv)

    input_paths, errors = _expand_inputs(args.inputs)
    if args.output and len(input_paths) != 1:
        parser.error("--output requires exactly one input file")

    for error in errors:
        print(error, file=sys.stderr)

    exit_code = int(bool(errors))
    for input_path in input_paths:
        if not input_path.exists():
            print(f"Input file not found: {input_path}", file=sys.stderr)
            exit_code = 1
            continue

        try:
            width, height = _probe_resolution(input_path)
        except (RuntimeError, OSError) as exc:
            print(f"Resolution probe failed for {input_path}: {exc}", file=sys.stderr)
            exit_code = 1
            continue

        if args.keep_bitrate:
            try:
                bitrate = _probe_video_bitrate(input_path)
            except (RuntimeError, OSError) as exc:
                print(f"Video bitrate probe failed for {input_path}: {exc}", file=sys.stderr)
                exit_code = 1
                continue
        else:
            bitrate = args.video_bitrate

        video_settings = VideoSettings(
            bitrate=bitrate,
            crf=args.crf,
            frame_rate=args.frame_rate,
        )
        scale_filter = _scale_filter(width, height, args.min_side)
        output_path = _output_path(input_path, args.output, args.min_side, video_settings)

        try:
            exit_code = _run_ffmpeg(input_path, output_path, scale_filter, video_settings) or exit_code
        except FileNotFoundError as exc:
            print(f"ffmpeg not found: {exc}", file=sys.stderr)
            return 1

    return exit_code


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
